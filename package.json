{
  "name": "pos_yoto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/services/**/*.spec.{js,jsx}",
    "coverage": "vitest run --coverage",
    "prisma:generate:test": "cross-env DATABASE_URL_TEST=file:./dev-test.db prisma generate --schema=prisma/schema.test.prisma",
    "prisma:push:test": "cross-env DATABASE_URL_TEST=file:./dev-test.db prisma db push --schema=prisma/schema.test.prisma",
    "test:integration": "npm run prisma:generate:test && npm run prisma:push:test && cross-env NODE_ENV=test DATABASE_URL_TEST=file:./dev-test.db vitest run src/app/api/ingredient/ingredient.integration.spec.js src/app/api/providers/providers.integration.spec.js src/app/api/sale/sale.integration.spec.js",
    "audit:styles": "node scripts/audit-styles.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@react-google-maps/api": "^2.19.3",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "imapflow": "^1.2.18",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.563.0",
    "luxon": "^3.5.0",
    "mysql2": "^3.14.1",
    "nanoid": "^5.0.9",
    "next": "14.2.3",
    "next-auth": "^4.24.7",
    "next-pwa": "^5.6.0",
    "puppeteer": "^23.11.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.4",
    "react-icons": "^5.3.0",
    "recharts": "^3.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.1",
    "vitest": "^1.6.0"
  }
}
